#!/usr/bin/env bash
# config/defaults.env — default build configuration.
# Uses `:=` so anything already exported by the environment always
# wins. Export to override; don't edit and export at the same time.

# Identity
: "${KERNEL_NAME:=RockKernel}"          # LOCALVERSION suffix
: "${ZIP_PREFIX:=Rock-Kernel}"          # output zip filename prefix
: "${BUILD_USER_NAME:=MaL}"
: "${BUILD_HOST_NAME:=1304}"

# Sources
: "${KERNEL_REPO:=https://github.com/Anomali1304/android_kernel_xiaomi_rock.git}"
: "${KERNEL_BRANCH:=android12-5.10}"
: "${GKI_MANIFEST_BRANCH:=common-android12-5.10-lts}"
: "${VENDOR_MODULES_REPO:=https://github.com/Asmodeus7999/MTK_kernel_modules.git}"
: "${VENDOR_MODULES_BRANCH:=rock-u-oss}"
: "${USE_EXT_MODULES:=y}"               # y/n — build vendor MTK modules

# Kernel options
: "${LTO_MODE:=THIN}"                   # NONE / THIN / FULL
: "${ROOT_TYPE:=VANILLA}"               # VANILLA / RESUKISU / KSUN
: "${STRIP_DEBUG:=y}"                   # y/n

# Clang vendor
: "${CLANG_VENDOR:=GKI}"                # GKI / ZyC / Custom
: "${CLANG_CUSTOM_URL:=}"               # Custom only — tar.gz/tar.zst/tar.xz URL
: "${CLANG_CUSTOM_PATH:=}"              # Custom only — local path (skips download).
                                         # ZyC always downloads to $WORKSPACE/clang-zyc.

# Addons
: "${ADDONS:=}"                         # comma-separated, e.g. "overclock_mt6789" — packaged into its own zip too
: "${MODULES_FILTER:=}"                 # substring filter for the all-modules zip, blank = every .ko

# Run behavior
: "${RUN_MODE:=Full Run}"               # Dry Run / Full Run

export KERNEL_NAME ZIP_PREFIX BUILD_USER_NAME BUILD_HOST_NAME \
       KERNEL_REPO KERNEL_BRANCH GKI_MANIFEST_BRANCH \
       VENDOR_MODULES_REPO VENDOR_MODULES_BRANCH USE_EXT_MODULES \
       LTO_MODE ROOT_TYPE STRIP_DEBUG ADDONS MODULES_FILTER RUN_MODE \
       CLANG_VENDOR CLANG_CUSTOM_URL CLANG_CUSTOM_PATH
